
PORT=5013
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/ngo_volunteer_db?retryWrites=true&w=majority

# Authentication
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Frontend development address
FRONTEND_URL=http://127.0.0.1:5500

# TextBee SMS configuration
SMS_ENABLED=false
TEXTBEE_API_KEY=YOUR_TEXTBEE_API_KEY
TEXTBEE_DEVICE_ID=YOUR_TEXTBEE_DEVICE_ID
